{
  "name": "shuttl",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "test": "node --test tests/*.test.ts",
    "test:ui": "playwright test",
    "demo": "node --env-file-if-exists=.env server/seed.ts",
    "admin": "node --env-file-if-exists=.env server/admin.ts",
    "backup": "node --env-file-if-exists=.env server/backup.ts",
    "replay": "node --env-file-if-exists=.env server/replay.ts",
    "pilot:report": "node --env-file-if-exists=.env server/pilot-report.ts",
    "push:keys": "node server/push-keys.ts",
    "format": "prettier --write src server tests/*.test.ts tests/browser tests/capture-mockups.ts vite.config.ts playwright.config.ts README.md docs/*.md"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@stdlib/math-base-special-erfc": "0.2.5",
    "fastify": "5.12.5",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "3.6.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
