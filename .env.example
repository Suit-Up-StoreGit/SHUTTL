HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=./data/shuttl.sqlite
NODE_ENV=development
# Only enable after approving a calibrated individual-evidence policy.
VALIDATED_EVIDENCE_POLICY=false
# Demo seeding requires an explicit command and never runs on server startup.
ALLOW_DEMO_SEED=false

# Set an exact trusted reverse-proxy IP/CIDR when deploying behind a proxy.
TRUST_PROXY=
